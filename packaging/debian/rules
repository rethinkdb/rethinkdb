#!/usr/bin/make -f
# Debian binary package. The source package is produced by the CMake
# build-deb-src target, which copies this rules file into the dist tree.

package?=$(shell awk '/^Source:/ { print $$2 }' debian/control)
PVERSION?=$(shell cat debian/rethinkdb.version)
DEBUG?=0
BUILD_PORTABLE?=0
BUILD_DIR:=$(CURDIR)/build/debian

ifeq ($(DEBUG),0)
CMAKE_BUILD_TYPE:=Release
else
CMAKE_BUILD_TYPE:=Debug
endif

CMAKE_FLAGS:=-DCMAKE_BUILD_TYPE=$(CMAKE_BUILD_TYPE)
CMAKE_FLAGS+=-DCMAKE_INSTALL_PREFIX=/usr
CMAKE_FLAGS+=-DCMAKE_INSTALL_SYSCONFDIR=/etc
CMAKE_FLAGS+=-DRETHINKDB_LOCALSTATEDIR=/var
CMAKE_FLAGS+=-DRETHINKDB_VERSION=$(PVERSION)
CMAKE_FLAGS+=-DRETHINKDB_ALLOW_WARNINGS=ON
CMAKE_FLAGS+=-DRETHINKDB_SYMBOLS=ON
CMAKE_FLAGS+=-DRETHINKDB_FETCH_BOOST=ON
CMAKE_FLAGS+=-DRETHINKDB_FETCH_RE2=ON
CMAKE_FLAGS+=-DRETHINKDB_FETCH_QUICKJS=ON
CMAKE_FLAGS+=-DRETHINKDB_FETCH_GTEST=ON
CMAKE_FLAGS+=-DRETHINKDB_FETCH_JEMALLOC=ON
ifeq ($(BUILD_PORTABLE),1)
CMAKE_FLAGS+=-DRETHINKDB_BUILD_PORTABLE=ON
CMAKE_FLAGS+=-DRETHINKDB_FETCH_PROTOBUF=ON
endif

clean:
	dh_clean
	rm -rf $(BUILD_DIR)

install: build
	dh_clean
	dh_installdirs
	DESTDIR=$(CURDIR)/debian/$(package) cmake --install $(BUILD_DIR)

build:
	cmake -S . -B $(BUILD_DIR) $(CMAKE_FLAGS)
	cmake --build $(BUILD_DIR) --parallel
	touch build

binary-indep: install

binary-arch: install
	dh_installdocs -a
	dh_installchangelogs -a
	dh_strip --dbg-package=$(package)-dbg
	dh_compress -a
	dh_fixperms -a
	dh_installdeb -a
	dh_shlibdeps -a
	dh_gencontrol -a
	dh_md5sums -a
	dh_builddeb -a

binary: binary-indep binary-arch

.PHONY: binary binary-arch binary-indep clean install build
